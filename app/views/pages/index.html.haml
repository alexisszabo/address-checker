%div{'data-controller': 'address-checker'}
  .section{style:'padding-top: 1.5em; padding-bottom-0.75em'}
    .box
      =form_with url: '/address_checker/check', html: { data: { type: "html", action: "ajax:success->address-checker#displayResults ajax:complete->address-checker#completeResults ajax:beforeSend->address-checker#beforeSendResults ajax:error->address-checker#errorResults"}} do |form|
        .field
          .label Paste Exported Addresses Here
          .control
            = text_area_tag :addresses, nil, class: 'textarea'
        .field
          .label Country
          .control.select
            = select_tag :country, options_for_select(@countries)
        .field
          .label Province
          .control.select
            = select_tag :province, options_for_select(@provinces)
        .field
          .label Primary Language(s)
          .control.select
            = select_tag :valid_languages, options_for_select(@languages), multiple: true, id: 'language-select'
        .field
          .label Kind
          .control
            .is-inline
              = radio_button_tag 'kind', 'Local', true, {'data-action':"change->address-checker#kindIsLocal", 'data-target':'address-checker.kindLocal'}
              = label_tag 'Local', 'Local'
            .is-inline
              = radio_button_tag 'kind', 'Foreign-language', false, {'data-action':"change->address-checker#kindIsForeignLanguage", 'data-target':'address-checker.kindForeignLanguage'}
              = label_tag 'Foreign-language', 'Foreign-language'

        .field.foreign-language-only{style: 'display:none'}
          .label Statuses to Check
          .control
            - @statuses_default_on.each do |status|
              .is-inline
                = check_box_tag 'statuses[]', status, true
                = label_tag status, status
            - @statuses_default_off.each do |status|
              .is-inline
                = check_box_tag 'statuses[]', status, false
                = label_tag status, status
        =button_tag 'Check Addresses', class: 'button is-link', 'data-target':'address-checker.submit'
  .section{style: 'padding-top: 0.75em; padding-bottom: 1.5em'}
    #results{'data-target': 'address-checker.results'}